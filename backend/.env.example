# ==================================================================
# Casa AgriSchool V1 - Variables d'environnement requises
# ==================================================================
# IMPORTANT: Copier ce fichier en .env et remplir les valeurs.
# Ne jamais commiter le fichier .env dans Git !

# --- JWT (OBLIGATOIRE) ---
# Générer un secret fort (min. 32 octets en Base64) :
# openssl rand -base64 64
JWT_SECRET=VOTRE_SECRET_JWT_FORT_EN_BASE64_MINIMUM_256_BITS

# Durée de validité du token en millisecondes (défaut: 900000 = 15 minutes)
JWT_EXPIRATION_MS=900000

# --- Base de données ---
DB_URL=jdbc:mysql://localhost:3306/casa_agrischool?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# ATTENTION: Ne jamais utiliser root en production
DB_USERNAME=casagri_app
DB_PASSWORD=VOTRE_MOT_DE_PASSE_DB_FORT

# --- CORS (Origines autorisées, séparées par virgules) ---
# En développement: http://localhost:5173,http://localhost:3000
# En production: https://votre-domaine.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================================================================
# Notes de sécurité :
# 1. JWT_SECRET doit être unique par environnement (DEV ≠ STAGING ≠ PROD)
# 2. DB_USERNAME doit avoir les droits minimaux nécessaires
# 3. Ne pas exposer ces variables dans des logs ou réponses API
# ==================================================================
